{
  "name": "nyopasta",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:customer": "npm run dev --workspace=apps/customer",
    "dev:admin": "npm run dev --workspace=apps/admin",
    "build:shared": "npm run build --workspace=packages/shared",
    "build": "npm run build:shared && npm run build --workspace=apps/customer && npm run build --workspace=apps/admin",
    "build:deploy": "node scripts/build-deploy.mjs",
    "provision:backend": "node packages/shared/scripts/provision-appwrite.mjs"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.6.3",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "clsx": "^2.1.1",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.71.0",
    "node-appwrite": "^31.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  }
}
